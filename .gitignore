# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ehdl-*.tar

# Rust NIF build outputs.
/native/*/target/
/priv/native/

# Compiled native libs.
*.so
*.dylib

# Source snapshot tarballs (mix hw.snapshot).
ehdl_snapshot_*.tar.gz

# Editor / LSP / macOS cruft.
/.elixir_ls/
/.lexical/
.DS_Store
._*

# Scratch / debugging artifacts (not part of the project).
/tmp_*.exs
/*.tar.gz
/erl_crash.dump
/ackout.txt
/base_ops.v
/counter.v
/new_features.v
/synth_test.v


# Generated bring-up build artifacts (regenerated by build.exs).
/designs/hello_board/build/
/designs/mcp2515_bringup/build/
/designs/usb_vendor_bringup/build/
/designs/pipeline_bringup/build/
/designs/can_controller_bringup/build/

# Scratch / debug capture files.
/gd1.txt
/rawdash.txt
/decoder--*.csv

# libresdr_radio build artifacts (match the other designs)
/designs/libresdr_radio/build/
# generated / scratch working dirs
/_cetest/
/_emit/
/_fuzz/
/_prim/
/_to_delete/
*.bak

# design build snapshots / regenerable data / vendor refs
top.ex.*
/designs/libresdr_radio/pll/
/designs/libresdr_radio/*.bin
check.dtb
*.pdf

# libresdr_radio generated bitstreams / sweeps / logs
/designs/libresdr_radio/**/*.gz
/designs/libresdr_radio/**/*.bin
/designs/libresdr_radio/**/*.log
/designs/libresdr_radio/**/*.seed
/designs/libresdr_radio/**/*.frames
/designs/libresdr_radio/**/*.db

# generated FPGA build artifacts across ALL designs
# (ehdl source is .ex/.exs; .v/.json are emitted verilog / netlists)
designs/**/build/
designs/**/*.bit
designs/**/*.frames
designs/**/*.fasm
designs/**/*.json
designs/**/*.v
designs/**/*.lpf
designs/**/*.err
designs/**/*.log
